# ----------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon)
# ----------------------------------------------------
# Example Neon Connection String:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban_db?schema=public"

# ----------------------------------------------------
# 2. AUTH.JS (NextAuth v5)
# ----------------------------------------------------
# Generate via: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET="your_nextauth_auth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ----------------------------------------------------
# 3. CLOUDFLARE R2 (Task File Attachments)
# ----------------------------------------------------
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="kanban-attachments"
R2_PUBLIC_DOMAIN="https://pub-yourdomain.r2.dev"

# ----------------------------------------------------
# 4. INNGEST (Background Jobs & Schedulers)
# ----------------------------------------------------
# Local Inngest Dev Server runs automatically via: `npx inngest-cli@latest dev`
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ----------------------------------------------------
# 5. RESEND (Transactional Emails)
# ----------------------------------------------------
# Found in https://resend.com/api-keys
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Kanban App <onboarding@resend.dev>"
