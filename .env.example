# ====================================================
# ORBITASK - ENVIRONMENT VARIABLES CONFIGURATION
# ====================================================

# 1. DATABASE (PostgreSQL / Docker)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/orbitask?schema=public"

# 2. AUTHENTICATION (NextAuth v5)
AUTH_SECRET="generate_secret_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# 3. CLOUDFLARE R2 FILE STORAGE
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# 4. APP SETTINGS
APP_NAME="Orbitask"
